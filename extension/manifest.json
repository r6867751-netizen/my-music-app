{
  "manifest_version": 3,
  "name": "My Music - YouTube Music Controller",
  "version": "1.0.0",
  "description": "Control an open YouTube Music tab.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "My Music Controller"
  }
}
